{"event": "action_parsed", "timestamp": 1788954981.4097993, "iteration": 5, "parser": "file", "action": {"type": "tool", "tool": "write_file", "arguments": {"path": "tetris.html", "content": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"utf-8\">\n<title>Tetris</title>\n<style>\n  body { font-family: Arial, sans-serif; background: #111; color: #eee; text-align: center; }\n  canvas { background: #000; display: block; margin: 0 auto; border: 2px solid #555; }\n  #info { font-size: 12px; margin-top: 8px; }\n  #score { font-weight: bold; font-size: 14px; }\n  button { font-size: 12px; padding: 4px 10px; }\n</style>\n</head>\n<body>\n<canvas id=\"board\" width=\"240\" height=\"480\"></canvas>\n<div id=\"info\">\n  <div id=\"score\">Punkte: 0</div>\n  <div id=\"level\">Ebene: 1</div>\n  <div id=\"status\">Spiel l\u00e4uft</div>\n  <div id=\"instructions\">Steuerung: \u2190\u2191\u2192\u2193 Hard Drop (Leer) &nbsp;|&nbsp; <button id=\"restart\">Neustart</button></div>\n</div>\n<script>\nconst TETROMINOES = {\n  I: [[[[0,0],[0,1],[0,2],[0,3]],[[0,0],[1,0],[2,0],[3,0]]]],\n  O: [[[[0,0],[0,1],[1,0],[1,1]]]],\n  T: [[[[0,0],[1,0],[2,0],[1,1]],[[0,0],[0,1],[1,0],[1,1]]]],\n  S: [[[[0,1],[1,0],[1,1],[2,0]],[[0,0],[1,0],[1,1],[2,1]]]],\n  Z: [[[[0,0],[1,0],[1,1],[2,1]],[[0,1],[1,0],[2,0],[2,1]]]],\n  J: [[[[0,0],[0,1],[1,0],[2,0]],[[0,0],[0,1],[1,0],[2,0]]]],\n  L: [[[[0,1],[1,0],[2,0],[2,1]],[[0,0],[1,0],[1,1],[2,0]]]]\n};\nconst COLOURS = { I:'#00f0f0', O:'#fff', T:'#f0f', S:'#f0f0', Z:'#f0f0', J:'#f0f0', L:'#f0f0' };\nlet board = [], piece = null, pieceX = 0, pieceY = 0, pieceType = null, pieceRot = 0, score = 0, level = 1, status = 'laufen', lastTime = 0, dt = 0, dropTimer = 0, locked = false;\nconst canvas = document.getElementById('board');\nconst ctx = canvas.getContext('2d');\nconst scoreEl = document.getElementById('score');\nconst levelEl = document.getElementById('level');\nconst statusEl = document.getElementById('status');\nconst restartBtn = document.getElementById('restart');\n\nfunction createBoard() { board = Array.from({length: 20}, () => Array(10).fill(0)); }\nfunction createPiece() {\n  const types = Object.keys(TETROMINOES);\n  pieceType = types[Math.floor(Math.random() * types.length)];\n  pieceRot = 0;\n  piece = TETROMINOES[pieceType][0];\n  pieceX = 5; pieceY = 0;\n}\nfunction cells() { return piece.map(c => [pieceX + c[0], pieceY + c[1]]); }\nfunction rotate() {\n  piece = TETROMINOES[pieceType][(pieceRot + 1) % TETROMINOES[pieceType].length];\n  pieceRot = (pieceRot + 1) % TETROMINOES[pieceType].length;\n}\nfunction collide() { return cells().some(c => c[1] < 0 || c[1] >= 20 || c[0] < 0 || c[0] >= 10 || (board[c[1]] && board[c[1]][c[0]] !== 0)); }\nfunction move(dx, dy) { pieceX += dx; pieceY += dy; if (collide()) { pieceX -= dx; pieceY -= dy; return false; } return true; }\nfunction hardDrop() { while (move(0, 1)) { } pieceY += 1; if (!collide()) { pieceY -= 1; } lockPiece(); }\nfunction lockPiece() {\n  cells().forEach(c => { if (c[1] >= 0 && c[1] < 20) board[c[1]][c[0]] = pieceType; });\n  const lines = [];\n  for (let y = 0; y < 20; y++) { const row = board[y].filter(v => v !== 0); if (row.length === 10) { lines.push(y); for (let x = 0; x < 10; x++) board[y][x] = 0; } }\n  lines.forEach(y => { const above = y === 0 ? 0 : board[y - 1].filter(v => v !== 0).length; score += 100 * above + 300; level = Math.min(20, level + 1); });\n  scoreEl.textContent = 'Punkte: ' + score;\n  levelEl.textContent = 'Ebene: ' + level;\n  statusEl.textContent = 'Spiel l\u00e4uft';\n  if (lines.length) { setTimeout(spawn, 800); return; }\n  createPiece();\n}\nfunction spawn() {\n  if (pieceY === 0 && collide()) { statusEl.textContent = 'Spiel vorbei'; status = 'over'; return; }\n  createPiece();\n}\nfunction draw() {\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n  for (let y = 0; y < 20; y++) {\n    for (let x = 0; x < 10; x++) {\n      if (board[y][x]) ctx.fillStyle = COLOURS[board[y][x]];\n      else ctx.fillStyle = '#000';\n      ctx.fillRect(x * 24, y * 24, 24, 24);\n    }\n  }\n  if (piece) {\n    ctx.fillStyle = '#fff';\n    cells().forEach(c => ctx.fillRect((pieceX + c[0]) * 24, (pieceY + c[1]) * 24, 24, 24));\n    ctx.fillStyle = '#0f0';\n    ctx.fillRect(0, 0, 240, 24);\n  }\n}\nfunction step(timestamp) {\n  const now = timestamp || performance.now();\n  dt = now - lastTime;\n  lastTime = now;\n  if (dt > 1000) { dropTimer = 0; }\n  if (dt > 1000 / (level * 0.9)) { pieceY += 1; if (collide()) { pieceY -= 1; lockPiece(); } }\n  draw();\n  if (status === 'laufen') requestAnimationFrame(step);\n}\nfunction onKey(e) {\n  if (status !== 'laufen') return;\n  if (e.key === 'ArrowLeft') move(-1, 0);\n  else if (e.key === 'ArrowRight') move(1, 0);\n  else if (e.key === 'ArrowDown') move(0, 1);\n  else if (e.key === 'ArrowUp') { rotate(); if (collide()) { rotate(); } else if (!move(0, 0)) { pieceX += 1; move(0, 0); } }\n  else if (e.key === ' ') { hardDrop(); }\n}\nrestartBtn.addEventListener('click', () => { createBoard(); createPiece(); score = 0; level = 1; status = 'laufen'; scoreEl.textContent = 'Punkte: 0'; levelEl.textContent = 'Ebene: 1'; statusEl.textContent = 'Spiel l\u00e4uft'; draw(); });\ndocument.addEventListener('keydown', onKey);\ncreateBoard(); createPiece(); draw(); requestAnimationFrame(step);\n</script>\n</body>\n</html>\n"}}}
